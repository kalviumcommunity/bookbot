# ──────────────────────────────────────────────────────────────
# BookBot Frontend — Environment Variables
# Copy this file to .env for local development.
#
# For Netlify production deployment, set these in:
#   Netlify Dashboard → Site Settings → Environment variables
# ──────────────────────────────────────────────────────────────

# URL of the deployed BookBot backend API.
# Local development:
VITE_API_URL=http://localhost:8000

# Production (set this in Netlify dashboard, NOT in this file):
# VITE_API_URL=https://your-bookbot-api.onrender.com
