# ──────────────────────────────────────────────────────────────
# Frontend .env — LOCAL DEVELOPMENT ONLY
# This file is for local development. It is NOT used by Netlify.
#
# To configure production, set VITE_API_URL in the Netlify dashboard:
#   Site Settings → Environment variables → Add variable
#   Key:   VITE_API_URL
#   Value: https://your-backend-url.onrender.com
#
# NEVER put a real backend URL here — this file may be committed.
# ──────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:8000
