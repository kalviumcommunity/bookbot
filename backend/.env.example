# ──────────────────────────────────────────────────────────────
# BookBot Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Google Gemini AI ──────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://bookbotai.netlify.app

# ── Database ─────────────────────────────────────────────────
# Leave unset to use local SQLite (backend/bookbot.db).
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# ── Server ───────────────────────────────────────────────────
# Port — set automatically by cloud platforms (Render, Fly, Railway).
# Leave unset for local dev (defaults to 8000).
# PORT=8000

# ── Environment ──────────────────────────────────────────────
# Set to "development" locally to enable auto-reload.
# ENVIRONMENT=development
